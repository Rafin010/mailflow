# Database Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rafmail

# Security & JWT Auth
SECRET_KEY=generate_a_strong_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# SendGrid (Outbound Email)
SENDGRID_API_KEY=your_sendgrid_api_key_here
DEFAULT_FROM_EMAIL=system@rafmail.com

# Frontend URL (For CORS)
FRONTEND_URL=http://localhost:3000

# Redis / Upstash (Optional - for rate limiting)
REDIS_URL=redis://localhost:6379/0
